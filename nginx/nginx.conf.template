# Quantos processos de trabalho devem ser executados. O ideal é que seja igual ao número de núcleos do processador.
worker_processes  auto;


events {
    worker_connections  1024;
}


http {

    # tipos de dados que o servidor pode servir, como HTML, CSS, JavaScript, imagens, etc.
    include      /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on; # kernel envia direto para o socket 
    tcp_nopush      on; # otimiza envio de arquivos maiores
    tcp_nodelay     on; # otimiza envio de arquivos menores

    keepalive_timeout  65;

    server_tokens off; 

    client_max_body_size 10M;
 
    log_format main '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" '
                    'rt=$request_time';    

    access_log /var/log/nginx/access.log main;
    error_log  /var/log/nginx/error.log warn;

    # Rate limiting, limita o número de requisições/min por IP
    limit_req_zone $binary_remote_addr zone=api_limit:30m rate=${RATE_LIMIT_RPM}r/m;


    # Load balancer define o grupo de servidores backend para balanceamento de carga

    upstream node_backend { 
        least_conn; # envia para servidor com menos conexões ativas
        server mcp-server:3000 max_fails=3 fail_timeout=30s;  

        # Instâncias para possível escalabilidade futura
        # server mcp-server-2:3000 
        # server mcp-server-3:3000
    }

    server {

        listen 80;
        server_name localhost; 
         

        # Segurança: cabeçalhos HTTP para proteção contra ataques comuns
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-XSS-Protection "1; mode=block" always;

       # Rate limit, até 10 requisições extras sem fila
       limit_req zone=api_limit burst=10 nodelay;

        location /favicon.ico {
            access_log off; 
            log_not_found off; 
            return 204;
        }
        
        # Onde as requisições estão sendo direcionadas, como por exemplo /api
        location /mcp {
            proxy_pass http://node_backend/mcp;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;

            proxy_set_header Connection ''; 
            

            proxy_buffering off; 
            proxy_cache_bypass $http_upgrade; # protege contra cache de conexões WebSocket
            
            proxy_intercept_errors on; # permite interceptar erros do backend e retornar páginas personalizadas

            # Cabeçalhos para manter informações do cliente original, como IP e protocolo
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr; 
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; 
            proxy_set_header X-Forwarded-Proto $scheme; # histórico de proxys

            proxy_connect_timeout 5s;
            proxy_send_timeout 3600s;# tempo para o backend processar a requisição, importante para operações longas
            proxy_read_timeout 3600s; 

        }
        # Reduzir log de requisições para favicon, que geralmente não existem 

        # healthcheck 
        location /mcp/health {
            proxy_pass http://node_backend/health;
        
        }

        error_page 502 503 504 = @json_error;
        location @json_error{

            default_type application/json;

            return 503 '{
                \"error\": \"Service Unavailable\",
                \"message\": \"MCP  server unavaliable\"
            }';
        }
        # Servidor não implement oauth, então retorna 404 para evitar exposição de endpoints relacionados
        location = /.well-known/oauth-authorization-server {
            return 404;
        }
    }

}
